datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ------------------------------------------------------
// IDENTITY & AUTHENTICATION
// ------------------------------------------------------

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  firstName    String   @default("Usuario")
  lastName     String   @default("Desconocido")
  documentId   String?  @unique
  phone        String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  roles  Role[]      @relation("UserRoles")
  tokens UserToken[]
  assignedPqrs PqrsTicket[]

  // Correspondence relations
  createdRouteSheets  RouteSheet[] @relation("CreatedRouteSheets")
  assignedRouteSheets RouteSheet[] @relation("AssignedRouteSheets")
  sourceMovements     HrMovement[] @relation("SourceMovements")

  // Link to the rich Person profile (Socio, Beneficiary)
  person Person?

  @@map("users")
}

model Role {
  id          String       @id @default(uuid())
  name        String       @unique
  description String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  users       User[]       @relation("UserRoles")
  permissions Permission[] @relation("RolePermissions")

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  roles       Role[]   @relation("RolePermissions")

  @@map("permissions")
}

model UserToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@map("user_tokens")
}

// ------------------------------------------------------
// MEMBERS MODULE (SOCIOS)
// ------------------------------------------------------

// 1. Socio (Persona)
model Person {
  id     String  @id @default(uuid())
  userId String? @unique // Optional link to auth User
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  documentId          String    @unique
  docType             String    @default("CI") // CI, PASAPORTE, EXTRANJERO
  docExtension        String?   // LP, CB, SC, OR, PT, TJ, CH, BE, PA
  firstName           String
  secondName          String?
  lastName            String?
  paternalSurname     String?
  maternalSurname     String?
  marriedSurname      String?   // Casada de
  alphaCode           String?   // GON-DUR-M-L
  birthDate           DateTime?
  gender              String?
  maritalStatus       String?   // SOLTERO, CASADO, DIVORCIADO, CONCUBINO, VIUDO
  nationality         String?   @default("BOLIVIANA")
  profession          String?
  occupation          String?
  company             String?
  address             String?
  city                String?   @default("LP")
  phone               String?
  mobile              String?
  email               String?
  photoUrl            String?
  digitalSignatureUrl String?
  status              String    @default("ACTIVO") // ACTIVO, SUSPENDIDO, FALLECIDO, RETIRADO, AUSENTE, HONORARIO
  personType          String    @default("SOCIO") // SOCIO, RECIPROCITY, EXTERNAL, PRE_ASOCIADO, JUNIOR_MAYOR, DEPORTIVO, HONORARIO

  // Fiscal & Invoicing
  fiscalNit           String?
  fiscalCompanyName   String?

  // Deposit voucher official entry rule
  depositVoucherNumber String?
  depositVoucherDate   DateTime? // Official entry date according to bank voucher
  depositVoucherAmount Decimal?  @default(0)

  // Financial info
  bankName            String?
  bankAccount         String?
  creditLimit         Decimal   @default(0)
  allowsDirectDebit   Boolean   @default(false)
  allowsMoraGrace     Boolean   @default(false)

  // Memberships where this person is the TITULAR
  titularMemberships Membership[] @relation("TitularMemberships")

  // Memberships where this person is a BENEFICIARY
  beneficiaries Beneficiary[]

  // Credentials (RFID, QR, etc)
  credentials Credential[]

  // Access Logs
  accessLogs AccessLog[]
  areaAccessLogs AreaAccessLog[]

  // Occasional Guests hosted by this person
  guests Guest[]

  // Financial Plans, Accruals, Charges & Payments
  membershipPlans       MembershipPlan[]
  socialFeeAccruals     SocialFeeAccrual[]
  extraordinaryCharges  ExtraordinaryCharge[]
  paymentTransactions   MemberPaymentTransaction[]
  refundRequests        MembershipRefundRequest[]

  // Correspondence
  routeSheets           RouteSheet[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("persons")
}

// ------------------------------------------------------
// GUESTS (Invitados Ocasionales)
// ------------------------------------------------------
model Guest {
  id           String   @id @default(uuid())
  hostId       String?  // Socio que invitó (opcional)
  host         Person?  @relation(fields: [hostId], references: [id], onDelete: SetNull)
  firstName    String
  lastName     String
  documentId   String?
  phone        String?
  email        String?
  notes        String?
  status       String   @default("ACTIVO")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  accessLogs   AccessLog[]

  @@map("guests")
}

// 3. Tipos de Membresía
model MembershipType {
  id               String  @id @default(uuid())
  code             String  @unique // TIT, FAM, HON, VIT, IND, JUN, JMA, TRN, TRE, PRE, DEP, MEN
  name             String
  monthlyFee       Decimal @default(0)
  maxBeneficiaries Int     @default(0)
  votingRights     Boolean @default(false)
  hasCdp           Boolean @default(true) // Vínculo Patrimonial
  benefits         String?
  accessRules      String?

  memberships Membership[]

  @@map("membership_types")
}

// 2. Membresía (Patrimonio)
model Membership {
  id               String @id @default(uuid())
  membershipNumber String @unique

  typeId String
  type   MembershipType @relation(fields: [typeId], references: [id])

  titularId String
  titular   Person @relation("TitularMemberships", fields: [titularId], references: [id])

  status             String    @default("ACTIVA") // ACTIVA, SUSPENDIDA, BLOQUEADA, EN_VENTA, TRANSFERIDA, CANCELADA
  admissionDate      DateTime  @default(now())
  activationDate     DateTime?
  purchaseValue      Decimal   @default(0)
  currentValue       Decimal   @default(0)
  acquisitionMethod  String?   // COMPRA_DIRECTA, TRANSFERENCIA, HERENCIA
  isTransferable     Boolean   @default(true)
  hasShares          Boolean   @default(false)
  sharesQuantity     Int       @default(0)
  folioNumber        String?
  physicalDossierLoc String?
  observations       String?
  totalDebt          Decimal   @default(0) // Financial state caching (real mora devengada)

  beneficiaries Beneficiary[]
  history       MembershipHistory[]
  vehicles      Vehicle[]
  horses        Horse[]
  pets          Pet[]
  plans         MembershipPlan[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("memberships")
}

// 4. Beneficiarios (Grupo Familiar)
model Beneficiary {
  id           String     @id @default(uuid())
  membershipId String
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  personId     String
  person       Person     @relation(fields: [personId], references: [id], onDelete: Cascade)

  relationship            String    // CONYUGE, HIJO, PADRE_MADRE, NIETO, INVITADO_PERMANENTE, NANA, CHOFER
  birthDate               DateTime? // For < 25 years rule
  isUnder25               Boolean   @default(true)
  docId                   String?
  docExtension            String?
  photoUrl                String?
  status                  String    @default("ACTIVO") // ACTIVO, INACTIVO, BLOQUEADO_EDAD
  specialRelationshipNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([membershipId, personId])
  @@map("beneficiaries")
}

// ------------------------------------------------------
// FINANCIAL & OPERATIONAL CDP MODELS (MÓDULO DE GESTIÓN DE SOCIOS)
// ------------------------------------------------------

model MembershipPlan {
  id                      String   @id @default(uuid())
  membershipId            String
  membership              Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  titularId               String
  titular                 Person   @relation(fields: [titularId], references: [id])
  
  transactionNumber       String   @unique // ej. AME-2026-001
  acquisitionType         String   @default("COMPRA_DIRECTA") // COMPRA_DIRECTA, TRANSFERENCIA, HERENCIA
  status                  String   @default("EN_REVISION") // EN_REVISION, APROBADO, OBSERVADO, CANCELADO
  
  sellerName              String?  // ej. "Eduardo (Comercial)"
  auditedBy               String?  // ej. "Mónica (Recaudaciones)"
  auditDate               DateTime?
  auditNotes              String?
  
  totalAmount             Decimal  // Monto total acordado
  incomeFeeAmount         Decimal  // 60% Derecho de Ingreso (Sujeto a Factura)
  cdpAmount               Decimal  // 40% Cuota de Participación (Sujeto a Recibo)
  downPayment             Decimal  // Cuota inicial abonada
  financedAmount          Decimal  // Saldo financiado
  monthsTerm              Int      @default(60) // 1 a 60 meses
  monthlyInterestRate     Decimal  @default(0)  // Tasa de interés mensual
  fixedMonthlyInstallment Decimal  // Cuota fija mensual
  paymentMethodType       String   @default("CREDITO") // CREDITO, CONTADO
  
  startDate               DateTime @default(now())
  firstDueDate            DateTime?
  originalSocioId         String?  // En caso de herencia/transferencia
  folioNumber             String?  // Número de folio del título
  shareCertificateNumber  String?  // Certificado impreso al liquidar 60/60
  isFullyPaid             Boolean  @default(false)
  
  installments            MembershipInstallment[]
  
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@map("membership_plans")
}

model MembershipInstallment {
  id                String   @id @default(uuid())
  planId            String
  plan              MembershipPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  
  installmentNumber Int      // 1 to 60
  dueDate           DateTime
  incomeFeePart     Decimal  // 60% Derecho de Ingreso
  cdpPart           Decimal  // 40% Cuota de Participación
  capitalAmount     Decimal
  interestAmount    Decimal  @default(0)
  totalInstallment  Decimal
  
  amountPaid        Decimal  @default(0)
  balanceRemaining  Decimal
  status            String   @default("PENDIENTE") // PENDIENTE, PARCIAL, PAGADO
  paidAt            DateTime?
  
  receiptNumber     String?
  invoiceNumber     String?
  
  allocations       PaymentAllocation[]
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("membership_installments")
}

model SocialFeeAccrual {
  id               String   @id @default(uuid())
  personId         String
  person           Person   @relation(fields: [personId], references: [id])
  membershipId     String?
  
  periodMonth      Int      // 1 - 12
  periodYear       Int      // 2026
  periodLabel      String   // "Enero 2026"
  feeType          String   @default("PRESENTE") // PRESENTE (880), AUSENTE (440), HONORARIO (0), MENOR (103), PRE_ASOCIADO (880), DEPORTIVO (400)
  
  baseAmount       Decimal
  paidAmount       Decimal  @default(0)
  residualBalance  Decimal  // Saldo pendiente (ej. arrastre de 80 Bs)
  dueDate          DateTime
  status           String   @default("PENDIENTE") // PENDIENTE, PARCIAL, PAGADO
  
  invoiceNumber    String?
  allocations      PaymentAllocation[]
  
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("social_fee_accruals")
}

model ExtraordinaryCharge {
  id                 String   @id @default(uuid())
  personId           String?
  person             Person?  @relation(fields: [personId], references: [id])
  
  clientType         String   @default("SOCIO") // SOCIO, CLIENTE_EXTERNO
  externalClientName String?
  externalClientNit  String?
  
  serviceCategory    String   // BOX_HIPICO, VETERINARIA, ESCUELA_DEPORTIVA, EVENTO, OTRO
  serviceName        String   // "Box Caballo Sultán", "Escuela Tenis Básico", "Atención Clínica Equina"
  clinicalNoteNumber String?  // Nro de Nota Médica Veterinaria
  
  periodMonth        Int
  periodYear         Int
  amount             Decimal
  paidAmount         Decimal  @default(0)
  residualBalance    Decimal
  dueDate            DateTime
  status             String   @default("PENDIENTE") // PENDIENTE, PARCIAL, PAGADO
  notes              String?
  invoiceNumber      String?
  
  veterinaryDetails  VeterinaryNoteDetail[]
  allocations        PaymentAllocation[]
  
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("extraordinary_charges")
}

model VeterinaryNoteDetail {
  id              String   @id @default(uuid())
  chargeId        String
  charge          ExtraordinaryCharge @relation(fields: [chargeId], references: [id], onDelete: Cascade)
  
  horseName       String
  boxNumber       String?
  itemDescription String   // ej. "Antibiótico Equino 50ml", "Desparasitante masivo", "Honorario Médico"
  quantity        Float    @default(1)
  unitPrice       Decimal
  subtotal        Decimal
  
  createdAt       DateTime @default(now())

  @@map("veterinary_note_details")
}

model MemberPaymentTransaction {
  id                 String   @id @default(uuid())
  transactionCode    String   @unique // ej. CSO-2026-00042
  personId           String
  person             Person   @relation(fields: [personId], references: [id])
  
  paymentDate        DateTime @default(now())
  paymentMethod      String   @default("EFECTIVO") // EFECTIVO, TARJETA, TRANSFERENCIA, DEBITO, CHEQUE
  currency           String   @default("BOB")      // BOB, USD
  exchangeRate       Decimal  @default(6.96)
  
  totalAmount        Decimal
  invoicedAmount     Decimal  @default(0) // Cuotas sociales, derecho de ingreso 60%, servicios gravados
  cdpReceiptAmount   Decimal  @default(0) // 40% Cuota de participación CDP (Recibo Oficial no gravado)
  
  invoiceNumber      String?
  invoiceAuthCode    String?
  fiscalNit          String?
  fiscalRazonSocial  String?
  receiptNumber      String?
  
  cashRegisterRef    String   @default("CAJA_CENTRAL")
  cashierUsername    String   // Cajero de turno
  shiftNumber        String?
  notes              String?
  status             String   @default("APROBADO") // APROBADO, ANULADO
  
  allocations        PaymentAllocation[]
  
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("member_payment_transactions")
}

model PaymentAllocation {
  id                    String   @id @default(uuid())
  paymentId             String
  payment               MemberPaymentTransaction @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  
  conceptType           String   // SOCIAL_FEE, CDP_INSTALLMENT, EXTRAORDINARY_CHARGE
  allocatedAmount       Decimal
  
  socialFeeId           String?
  socialFee             SocialFeeAccrual? @relation(fields: [socialFeeId], references: [id])
  
  installmentId         String?
  installment           MembershipInstallment? @relation(fields: [installmentId], references: [id])
  
  extraordinaryChargeId String?
  extraordinaryCharge   ExtraordinaryCharge? @relation(fields: [extraordinaryChargeId], references: [id])
  
  notes                 String?
  createdAt             DateTime @default(now())

  @@map("payment_allocations")
}

model AssemblySession {
  id                          String   @id @default(uuid())
  title                       String   // "Asamblea General Ordinaria de Socios 2026"
  sessionDate                 DateTime
  cutoffTime                  DateTime // 15:00 hrs
  isCensusFrozen              Boolean  @default(false)
  maxDebtToleranceMonths      Int      @default(1) // 1 mes de mora permitido
  status                      String   @default("PROGRAMADA") // PROGRAMADA, EN_CURSO, FINALIZADA, CANCELADA
  
  totalEligiblePropietarios   Int      @default(0)
  totalEligibleInstitucionales Int     @default(0)
  totalPresent                Int      @default(0)
  quorumPercentage            Float    @default(0)
  notes                       String?
  
  attendees                   AssemblyAttendee[]
  
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt

  @@map("assembly_sessions")
}

model AssemblyAttendee {
  id                  String   @id @default(uuid())
  sessionId           String
  session             AssemblySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  
  personId            String
  membershipNumber    String
  fullName            String
  documentId          String
  attendeeCategory    String   // TITULAR_PROPIETARIO, INSTITUCIONAL
  eligibleAtCutoff    Boolean  @default(true)
  registeredInSitu    Boolean  @default(false) // Si pagó en caja express de puerta
  inSituReceiptNumber String?
  hasSigned           Boolean  @default(false)
  signatureTimestamp  DateTime?
  signatureType       String   @default("MANUAL") // MANUAL, DIGITAL
  
  createdAt           DateTime @default(now())

  @@map("assembly_attendees")
}

model SystemFinancialParameter {
  id             String   @id @default(uuid())
  parameterKey   String   @unique // CUOTA_SOCIAL_PRESENTE, CUOTA_SOCIAL_AUSENTE, BOX_HIPICO_MENSUAL, etc.
  parameterValue String   // "880.00", "195.00", "60", "40"
  numericValue   Decimal?
  description    String
  category       String   @default("TARIFAS") // TARIFAS, PORCENTAJES, REGLAS, MORA
  updatedBy      String?
  updatedAt      DateTime @updatedAt

  @@map("system_financial_parameters")
}

model MembershipRefundRequest {
  id                     String   @id @default(uuid())
  requestCode            String   @unique // REF-2026-001
  personId               String
  person                 Person   @relation(fields: [personId], references: [id])
  
  reason                 String   // "Prorrateo Anualidad por Pase a Socio Honorario"
  monthsInFavor          Int      // ej. 7 meses
  monthlyFee             Decimal  // ej. 880.00
  grossRefundAmount      Decimal  // ej. 6160.00
  taxRetentionPercentage Decimal  @default(12.5) // Retención impositiva de ley
  taxRetentionAmount     Decimal
  netRefundAmount        Decimal
  
  bankName               String
  bankAccountNumber      String
  bankAccountType        String   @default("CUENTA_CORRIENTE") // CUENTA_CORRIENTE, CAJA_AHORRO
  beneficiaryName        String
  
  status                 String   @default("PENDIENTE_TESORERIA") // PENDIENTE_TESORERIA, APROBADO_TESORERIA, PAGADO, RECHAZADO
  treasuryApprovedBy     String?
  treasuryPaymentRef     String?
  supportingDocUrl       String?
  
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@map("membership_refund_requests")
}

// 6. Historial de la Membresía
model MembershipHistory {
  id           String     @id @default(uuid())
  membershipId String
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  date         DateTime   @default(now())
  action       String // Cambio de categoría, Transferencia, Suspensión, etc.
  reason       String?
  performedBy  String? // Usuario que realizó la acción

  @@map("membership_history")
}

// 8. Credenciales
model Credential {
  id        String   @id @default(uuid())
  personId  String
  person    Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  type      String // QR, BARRAS, RFID, HUELLA, FACIAL
  value     String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@map("credentials")
}

// 9. Vehículos
model Vehicle {
  id           String     @id @default(uuid())
  membershipId String
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  type         String // Auto, Motocicleta, Bicicleta, Remolque
  plate        String     @unique
  brand        String?
  model        String?
  color        String?

  @@map("vehicles")
}

// 10. Mascotas
model Pet {
  id           String     @id @default(uuid())
  membershipId String
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  name         String
  breed        String?
  vaccines     String?
  photoUrl     String?

  @@map("pets")
}

// 11. Caballos
model Horse {
  id             String     @id @default(uuid())
  membershipId   String
  membership     Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  name           String
  assignedBox    String?
  coOwners       String?
  hiredServices  String?
  feedingDiet    String?
  veterinarian   String?
  farrier        String? // Herrador
  competitions   String?
  medicalHistory String?

  @@map("horses")
}

// 12. Accesos
model AccessLog {
  id           String   @id @default(uuid())
  personId     String?
  person       Person?  @relation(fields: [personId], references: [id])
  timestamp    DateTime @default(now())
  gate         String // e.g. "Puerta Principal"
  method       String // e.g. "Reconocimiento Facial", "Manual"
  actionType   String @default("ENTRY") // "ENTRY", "EXIT"
  personType   String @default("SOCIO") // Captured from Person
  status       String // "GRANTED", "DENIED"
  reason       String? // System reason (e.g. "Deuda Pendiente")
  observation  String? // Manual observation from the guard
  vehiclePlate String? // If they entered with a car

  guestId      String?
  guest        Guest?   @relation(fields: [guestId], references: [id], onDelete: SetNull)

  @@map("access_logs")
}

// 13. Accesos Específicos por Área (Piscina / Gimnasio)
model AreaAccessLog {
  id              String    @id @default(uuid())
  area            String    // "PISCINA" | "GIMNASIO"
  entryTime       DateTime  @default(now())
  exitTime        DateTime?
  memberCode      String?
  personName      String
  documentId      String?
  dependency      String    @default("TITULAR") // TITULAR, ESPOSA, HIJO, PADRE_MADRE, NIETO, INVITADO, PROFESOR, EXTERNO, CONVENIO, HUESPED
  gender          String    @default("VARON")   // VARON, MUJER
  lockerKey       String?   // Número de llave / casillero entregado
  towelNumber     String?   // Número de toalla entregada (ej: "45", "12", "T-08")
  towelQty        Int       @default(0)         // Cantidad de toallas entregadas
  towelSize       String?   // "GRANDE", "PEQUEÑA", "AMBAS", "NINGUNA"
  observations    String?
  status          String    @default("DENTRO")  // "DENTRO", "SALIO"
  registeredById  String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  personId        String?
  person          Person?   @relation(fields: [personId], references: [id], onDelete: SetNull)

  @@map("area_access_logs")
}

// 14. Configuración Dinámica de Áreas (Capacidad y Casilleros)
model AreaConfig {
  id           String   @id @default(uuid())
  area         String   @unique // "PISCINA" | "GIMNASIO"
  totalLockers Int      @default(50)
  maxCapacity  Int      @default(50)
  facilities   Json?    // Telemetry items: name, value, unit, status, type
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("area_configs")
}

// 15. Registro Periódico de Temperatura del Agua de Piscina
model PoolTemperatureLog {
  id            String   @id @default(uuid())
  temperature   Float    // Ej: 28.5
  ambientTemp   Float?   // Ej: 22.0
  phLevel       Float?   // Ej: 7.4
  chlorineLevel Float?   // Ej: 1.5
  notes         String?  // Ej: "Caldera funcionando normal"
  recordedBy    String?  // Nombre del funcionario que midió
  recordedAt    DateTime @default(now())
  createdAt     DateTime @default(now())

  @@map("pool_temperature_logs")
}

// ------------------------------------------------------
// WHATSAPP MODULE
// ------------------------------------------------------

model WhatsAppCampaign {
  id           String   @id @default(uuid())
  name         String
  message      String
  status       String   @default("EN_PROGRESO") // EN_PROGRESO, COMPLETA, CANCELADA
  total        Int      @default(0)
  successCount Int      @default(0)
  failCount    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("whatsapp_campaigns")
}

model WhatsAppChat {
  id            String   @id @default(uuid())
  phone         String   @unique
  contactName   String?
  unreadCount   Int      @default(0)
  lastMessage   String?
  lastMessageAt DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  messages      WhatsAppMessage[]

  @@map("whatsapp_chats")
}

model WhatsAppMessage {
  id         String   @id @default(uuid())
  chatId     String
  chat       WhatsAppChat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  content    String
  fromMe     Boolean  @default(true)
  status     String   @default("SENT") // SENT, DELIVERED, READ, FAILED
  timestamp  DateTime @default(now())
  hasMedia   Boolean  @default(false)

  @@map("whatsapp_messages")
}

// ------------------------------------------------------
// PQRS MODULE
// ------------------------------------------------------

model PqrsTicket {
  id                 String   @id @default(uuid())
  code               String   @unique
  trackingCode       String?  @unique
  fullName           String
  phone              String
  email              String?
  memberCode         String?
  type               String
  area               String?
  applicantCondition String
  description        String
  status             String   @default("ABIERTO")
  isRead             Boolean  @default(false)
  resolution         String?
  priority           String   @default("MEDIA")
  assignedToId       String?
  assignedTo         User?    @relation(fields: [assignedToId], references: [id])
  rating             Int?
  isWaitingForRating Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  history            PqrsHistory[]

  @@map("pqrs_tickets")
}

model PqrsHistory {
  id           String     @id @default(uuid())
  ticketId     String
  ticket       PqrsTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  action       String     // e.g. "CREADO", "ESTADO_ACTUALIZADO", "WHATSAPP_ENVIADO"
  description  String     // Detalles de la acción
  performedBy  String?    // User info or "System"
  createdAt    DateTime   @default(now())

  @@map("pqrs_history")
}

// ------------------------------------------------------
// RESERVATIONS MODULE
// ------------------------------------------------------

model Court {
  id                  String             @id @default(uuid())
  name                String
  sport               String             // e.g. "Frontón", "Tenis", "Pádel", "Polifuncional", "Raquet / Wally", "Ping Pong", "Fútbol"
  description         String?
  isActive            Boolean            @default(true)
  openingTime         String             @default("06:00")
  closingTime         String             @default("22:00")
  slotDurationMinutes Int                @default(60)
  hourlyRate          Float              @default(30.0) // Base court fee per hour
  guestRate           Float              @default(25.0) // Fee per external non-member guest
  reservations        CourtReservation[]

  @@map("courts")
}

model CourtReservation {
  id                String   @id @default(uuid())
  code              String?  @unique // ej. RES-84920 o RES-TEN-0042
  courtId           String
  court             Court    @relation(fields: [courtId], references: [id], onDelete: Cascade)
  date              String   // YYYY-MM-DD
  startTime         String   // HH:mm
  endTime           String   // HH:mm
  memberCode        String?
  memberName        String
  memberPhone       String?
  reservationType   String   @default("MEMBER") // MEMBER, CLASS, MAINTENANCE, TOURNAMENT, ESCUELA_DEPORTIVA, EVENTO_CLUB
  
  // Players & Modality details
  playerType        String   @default("FAMILY") // FAMILY, GUESTS, MEMBERS
  guestsCount       Int      @default(0)
  playerNames       String?  // Family members or Guest names or other Member names
  
  // Pricing & Payment
  courtFee          Float    @default(0.0)
  guestFee          Float    @default(0.0)
  totalPrice        Float    @default(0.0)
  paymentStatus     String   @default("PENDING_PAYMENT") // PENDING_PAYMENT, PAID, VERIFIED, EXEMPT
  paymentMethod     String?  @default("QR")             // QR, EFECTIVO, TARJETA, TRANSFERENCIA
  paymentReceiptUrl String?  // Receipt image URL if uploaded

  title             String?  // Title for class, tournament or maintenance
  notes             String?  // Additional details or instructor name
  isRecurring       Boolean  @default(false)
  recurringGroupId  String?  // Group identifier for recurring date/time range series
  adminCreatedBy    String?  // Admin username or ID
  status            String   @default("APPROVED") // PENDING, APPROVED, REJECTED, CANCELLED
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("court_reservations")
}

// ------------------------------------------------------
// COMMERCIAL & VIP ACCESS MODULE
// ------------------------------------------------------

model VipPass {
  id               String    @id @default(uuid())
  code             String    @unique // ej. VIP-CHLS-7892
  guestFullName    String
  documentId       String?   // CI o Pasaporte
  phone            String?
  email            String?
  hostSellerName   String    @default("Eduardo (Comercial)")
  
  // Date & Time window rules
  validFrom        DateTime
  validUntil       DateTime
  maxDays          Int       @default(1)
  timeStart        String    @default("07:00") // HH:mm
  timeEnd          String    @default("22:00") // HH:mm
  
  // Permitted areas: INGRESO, PISCINA, GIMNASIO, TENIS, HIPICA, RESTAURANTE
  allowedAreas     String    @default("INGRESO,PISCINA,GIMNASIO,TENIS,HIPICA,RESTAURANTE")
  
  // Status & Usage tracking
  status           String    @default("ACTIVO") // ACTIVO, USADO, EXPIRADO, REVOCADO
  usageCount       Int       @default(0)
  maxUses          Int       @default(10)
  lastUsedAt       DateTime?
  notes            String?
  
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@map("vip_passes")
}

model CommercialLead {
  id               String    @id @default(uuid())
  fullName         String
  documentId       String?
  phone            String?
  email            String?
  company          String?
  position         String?
  categoryInterest String    @default("FAMILIAR") // FAMILIAR, INDIVIDUAL, JUNIOR_MAYOR, DEPORTIVO, PRE_ASOCIADO
  status           String    @default("NUEVO_LEAD") // NUEVO_LEAD, VISITA_PROGRAMADA, PROPUESTA_ENVIADA, POSTULACION_AVAL, APROBADO_DIRECTORIO, CERRADO_GANADO, DESCARTADO
  sponsorMember1   String?
  sponsorMember2   String?
  sellerName       String?   @default("Eduardo (Comercial)")
  budgetEstimated  Decimal?
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@map("commercial_leads")
}

// ------------------------------------------------------
// CORRESPONDENCE & ROUTE SHEETS MODULE (CHLS 360°)
// ------------------------------------------------------

enum RouteSheetSenderType {
  SOCIO
  AREA_INTERNA
  EXTERNO
}

enum RouteSheetPriority {
  BAJA
  NORMAL
  ALTA
  URGENTE
}

enum RouteSheetStatus {
  RECIBIDO
  DERIVADO
  EN_PROCESO
  OBSERVADO
  SUBSANADO
  EN_APROBACION
  CONCLUIDO
  ANULADO
}

model RouteSheet {
  id                    String                @id @default(uuid())
  hrCode                String                @unique // ej. 08-193 o HR-2026-00193
  year                  Int                   @default(2026)
  correlativeNumber     Int                   @default(1)
  
  senderType            RouteSheetSenderType  @default(AREA_INTERNA)
  personId              String?               // Si es socio
  person                Person?               @relation(fields: [personId], references: [id], onDelete: SetNull)
  
  senderName            String                // Nombre remitente: ej. MARIA DEL PILAR ATANACIO
  senderArea            String?               // Área origen: ej. ALMACÉN, HÍPICA, etc.
  senderPhone           String?
  senderEmail           String?
  senderDoc             String?               // CI o NIT
  
  cite                  String?               // CITE: ej. ALM-INF N° 42/2026
  pageCount             Int                   @default(1)
  reference             String                // REFERENCIA: ej. SOLICITUD DE RECARGA PARA TONER...
  attachmentDescription String?               // ADJUNTO: ej. KARDEX CRONOLÓGICO CONSOLIDADO
  
  priority              RouteSheetPriority    @default(NORMAL)
  status                RouteSheetStatus      @default(RECIBIDO)
  currentArea           String                @default("SECRETARIA_GENERAL")
  currentAssigneeId     String?
  currentAssignee       User?                 @relation("AssignedRouteSheets", fields: [currentAssigneeId], references: [id], onDelete: SetNull)
  
  aiSummary             String?               // Resumen inteligente
  suggestedArea         String?
  
  // Archivo Institucional & Central
  archiveLocation       String?               // Ubicación física: ej. ARCHIVADOR CENTRAL / TOMO 2026-TES / GAVETA 03
  archiveBox            String?               // N° de Caja / Gaveta
  archiveNotes          String?               // Motivo de archivo / Auto de conclusión
  archivedAt            DateTime?
  archivedById          String?
  
  createdById           String
  createdBy             User                  @relation("CreatedRouteSheets", fields: [createdById], references: [id])
  
  movements             HrMovement[]
  documents             CorrDocument[]
  
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  @@map("corr_route_sheets")
}

model HrMovement {
  id               String         @id @default(uuid())
  routeSheetId     String
  routeSheet       RouteSheet     @relation(fields: [routeSheetId], references: [id], onDelete: Cascade)
  
  sequenceNumber   Int            @default(1)
  sourceUserId     String
  sourceUser       User           @relation("SourceMovements", fields: [sourceUserId], references: [id])
  sourceArea       String         @default("GERENCIA_GENERAL")
  
  targetArea       String         // ej. CONTRATACIONES, TESORERIA, HIPICA
  targetPersonName String?        // ej. Lic. Pinto, Lic. Meneses
  
  instruction      String         // Texto de la instrucción / proveído
  quickStamp       String?        // ej. FAVOR SU ATENCIÓN, FAVOR REALIZAR EL PAGO
  signatureUrl     String?        // Firma digital registrada o sello del emisor
  
  receivedAt       DateTime?
  createdAt        DateTime       @default(now())

  documents        CorrDocument[]

  @@map("corr_movements")
}

model CorrDocument {
  id                  String      @id @default(uuid())
  routeSheetId        String
  routeSheet          RouteSheet  @relation(fields: [routeSheetId], references: [id], onDelete: Cascade)
  
  movementId          String?
  movement            HrMovement? @relation(fields: [movementId], references: [id], onDelete: SetNull)

  fileName            String
  fileUrl             String
  mimeType            String?
  fileSize            Int?
  sha256Hash          String?     // Integridad de archivo
  qrVerificationToken String?     @unique
  
  createdAt           DateTime    @default(now())

  @@map("corr_documents")
}

model CorrChatMessage {
  id                String      @id @default(uuid())
  channel           String      @default("GENERAL") // GENERAL, SECRETARIA, GERENCIA, TESORERIA, CONTRATACIONES, CASETA
  senderUserId      String
  senderName        String
  senderArea        String      @default("SECRETARIA_GENERAL")
  message           String
  routeSheetCode    String?     // ej. 08-193 (enlace interactivo a la Hoja de Ruta)
  fileUrl           String?     // URL de descarga del archivo adjunto
  fileName          String?     // Nombre original del archivo (ej. Cotizacion_Arena.pdf)
  fileType          String?     // application/pdf, image/png, etc.
  fileSize          Int?        // Tamaño en bytes
  status            String      @default("SENT") // SENT (1 palomita), DELIVERED (2 palomitas grises), READ (2 palomitas celestes)
  readAt            DateTime?
  replyToId         String?     // ID del mensaje citado original
  replyToSenderName String?     // Remitente del mensaje citado
  replyToText       String?     // Fragmento del mensaje citado
  createdAt         DateTime    @default(now())

  @@map("corr_chat_messages")
}

// ------------------------------------------------------
// ELECCIONES DE DIRECTORIO (ELECTORAL SUITE)
// ------------------------------------------------------

model Election {
  id                    String    @id @default(uuid())
  title                 String    // ej. "Elecciones Ordinarias de Directorio 2026 - 2028"
  description           String?   // Convocatoria oficial emitida por el Comité Electoral
  period                String    // ej. "2026-2028"
  status                String    @default("EN_CURSO") // CONVOCADA, EN_CURSO, FINALIZADA, PROCLAMADA
  startDate             DateTime  @default(now())
  endDate               DateTime
  quorumMinimum         Int       @default(25) // Porcentaje mínimo estatutario de participación (ej. 25%)
  maxSelectionsPerBallot Int      @default(5)  // Límite parametrizable de candidatos por boleta (ej. hasta 5, o 0 para libre)
  rulesHtml             String?   // Reglamento electoral en texto enriquecido
  closingActUrl         String?   // URL o ruta al Acta Notarial de Cierre generada
  createdById           String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  candidates            ElectionCandidate[]
  slates                ElectionSlate[]
  voters                ElectionVoter[]
  ballots               ElectionBallot[]
  auditLogs             ElectionAuditLog[]

  @@map("elections")
}

model ElectionSlate {
  id             String              @id @default(uuid())
  electionId     String
  election       Election            @relation(fields: [electionId], references: [id], onDelete: Cascade)
  
  name           String              // ej. "Renovación y Tradición Hípica"
  code           String              // ej. "F1", "F2", "LISTA-A"
  slogan         String?             // ej. "Modernidad, Excelencia y Pasión por el Deporte"
  colorHex       String              @default("#10b981") // Color representativo del frente
  logoUrl        String?             // Emblema o isotipo del frente
  planDocUrl     String?             // Documento en PDF del plan de gestión
  orderIndex     Int                 @default(1)
  isActive       Boolean             @default(true)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  candidates     ElectionCandidate[]

  @@map("election_slates")
}

model ElectionCandidate {
  id               String         @id @default(uuid())
  electionId       String
  election         Election       @relation(fields: [electionId], references: [id], onDelete: Cascade)
  slateId          String?
  slate            ElectionSlate? @relation(fields: [slateId], references: [id], onDelete: SetNull)

  fullName         String
  position         String?        @default("Postulante al Directorio")
  membershipNumber String?        // Matrícula de socio (ej. "TIT-1042")
  photoUrl         String?
  bio              String?
  colorHex         String         @default("#0b532c")
  orderIndex       Int            @default(1)
  isActive         Boolean        @default(true)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@map("election_candidates")
}

model ElectionVoter {
  id                  String    @id @default(uuid())
  electionId          String
  election            Election  @relation(fields: [electionId], references: [id], onDelete: Cascade)

  personId            String
  membershipNumber    String    // ej. "TIT-1042"
  documentId          String    // CI o DNI del socio
  fullName            String
  isEligible          Boolean   @default(true) // Habilitado para votar
  ineligibilityReason String?   // ej. "Mora pendiente", "Beneficiario sin derecho estatutario a voto"
  hasVoted            Boolean   @default(false)
  votedAt             DateTime?
  votingMethod        String?   @default("FISICA_ANFORA") // FISICA_ANFORA, ONLINE, PRESENCIAL_TABLET
  certificateHash     String?   @unique // Token único del certificado de sufragio
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@unique([electionId, personId])
  @@map("election_voters")
}

model ElectionBallot {
  id                   String    @id @default(uuid())
  electionId           String
  election             Election  @relation(fields: [electionId], references: [id], onDelete: Cascade)

  ballotNumber         Int       @default(1)
  ballotType           String    @default("VALID") // VALID, BLANK, NULL
  selectedCandidateIds String[]  @default([]) // IDs de los candidatos marcados en esta boleta
  notes                String?
  registeredBy         String?   @default("MESA_1")
  voteHash             String?   // SHA-256 inmutable de auditoría
  castAt               DateTime  @default(now())

  @@map("election_ballots")
}

model ElectionAuditLog {
  id             String    @id @default(uuid())
  electionId     String
  election       Election  @relation(fields: [electionId], references: [id], onDelete: Cascade)

  action         String    // APERTURA_URNAS, CIERRE_URNAS, EMISION_VOTO, GENERACION_ACTA, MODIFICACION_PADRON
  details        String?
  performedBy    String?   // Nombre o email del usuario o "SISTEMA"
  ipAddress      String?
  createdAt      DateTime  @default(now())

  @@map("election_audit_logs")
}
